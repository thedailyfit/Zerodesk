{
  "name": "zerodesk",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "pnpm --filter @zerodesk/api start:prod",
    "start:api": "node apps/api/dist/main.js",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "db:generate": "pnpm --filter @zerodesk/api db:generate",
    "db:migrate": "pnpm --filter @zerodesk/api db:migrate",
    "db:migrate:prod": "node scripts/apply-production-migration.js",
    "db:backup": "node scripts/backup-db.js",
    "db:push": "pnpm --filter @zerodesk/api db:push",
    "db:seed": "pnpm db:generate && pnpm --filter @zerodesk/api db:seed",
    "db:studio": "pnpm --filter @zerodesk/api db:studio",
    "preflight": "node scripts/preflight-check.js",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "8.5.23",
      "qs@<6.16.0": "6.16.0",
      "fast-uri@<3.1.8": "3.1.8",
      "nanoid@3": "3.3.19",
      "multer@2": "2.4.0",
      "sharp@0.34": "0.35.4",
      "deepmerge-ts@7": "8.0.0",
      "js-yaml@<5.4.1": "5.4.1",
      "brace-expansion@5": "5.0.12",
      "engine.io@6": "6.6.11",
      "dompurify@3": "3.4.16"
    }
  }
}
