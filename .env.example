# ============================================================
# ZERODESK AI — ENVIRONMENT CONFIGURATION
# ============================================================

# App
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
ENCRYPTION_SECRET_KEY=zerodesk_secure_aes256_encryption_key_2026_prod

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://zerodesk:zerodesk_pass@localhost:5432/zerodesk?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk — free tier: 10K MAUs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuYXBwLmRldiQ
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ============================================================
# LLM PROVIDERS (Multi-Provider with Failover)
# ============================================================
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================
# VOICE AI PROVIDERS (Dual: Vapi + Retell AI)
# ============================================================

# Vapi AI
VAPI_API_KEY=xxx
VAPI_PHONE_NUMBER_ID=xxx
VAPI_WEBHOOK_URL=https://api.yourdomain.com/v1/voice/webhook/vapi

# Retell AI
RETELL_API_KEY=xxx
RETELL_WEBHOOK_URL=https://api.yourdomain.com/v1/voice/webhook/retell

# ============================================================
# MESSAGING
# ============================================================

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx
WHATSAPP_VERIFY_TOKEN=zerodesk_webhook_verify_token_2024
WHATSAPP_WEBHOOK_URL=https://api.yourdomain.com/v1/whatsapp/webhook

# ============================================================
# INTEGRATIONS
# ============================================================

# n8n Workflow Automation (self-hosted)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=xxx

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=zerodesk-uploads
R2_PUBLIC_URL=https://cdn.zerodesk.ai

# ============================================================
# BILLING
# ============================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# ============================================================
# DEPLOYMENT (Singapore/India Region)
# ============================================================
RAILWAY_ENVIRONMENT=production
RAILWAY_REGION=asia-southeast1
APP_URL=https://app.zerodesk.ai
API_URL=https://api.zerodesk.ai

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=xxx
LOG_LEVEL=info
