# ============================================================
# ZERODESK AI — ENVIRONMENT CONFIGURATION
# ============================================================

# App
NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
ENCRYPTION_SECRET_KEY=zerodesk_secure_aes256_encryption_key_2026_prod

# Database (PostgreSQL + pgvector — Supabase Supported)
# For Supabase: 
# DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=10&sslmode=require
# DIRECT_URL   = Session pooler or Direct connection (port 5432) with ?sslmode=require
DATABASE_URL=postgresql://zerodesk:zerodesk_pass@localhost:5432/zerodesk?schema=public
DIRECT_URL=postgresql://zerodesk:zerodesk_pass@localhost:5432/zerodesk?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Clerk — free tier: 10K MAUs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuYXBwLmRldiQ
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# ============================================================
# LLM PROVIDERS (3-Tier Cascade: ChatGPT -> Sarvam -> Gemini)
# ============================================================
DEFAULT_LLM_PROVIDER=openai

# OpenAI (Primary)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Sarvam AI (Secondary Indic Fallback)
SARVAM_API_KEY=sk_xxx
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Google Gemini (Tertiary Fallback)
GEMINI_API_KEY=AIzaxxx
GEMINI_MODEL=gemini-2.0-flash

# ============================================================
# VOICE & TELEPHONY (LiveKit Cloud Primary + Retell Fallback + Plivo)
# ============================================================

# Plivo Telephony (DID Phone Numbers & SIP Trunking)
PLIVO_AUTH_ID=MAYxxx
PLIVO_AUTH_TOKEN=xxx
PLIVO_APP_ID=xxx

# LiveKit Cloud (Primary Voice Platform)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=secretxxx
LIVEKIT_SIP_DOMAIN=sip.livekit.cloud

# Retell AI (Secondary Fallback Platform)
RETELL_API_KEY=xxx
RETELL_WEBHOOK_URL=https://api.yourdomain.com/v1/voice/webhook/retell

# Speech APIs
ELEVENLABS_API_KEY=sk_xxx
ELEVENLABS_VOICE_ID=90ipbRoKi4CpHXvKVtl0
INTERNAL_VOICE_SECRET=zerodesk-internal-voice-key-2026

# ============================================================
# MESSAGING
# ============================================================

# WhatsApp (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxx
WHATSAPP_VERIFY_TOKEN=zerodesk_webhook_verify_token_2024
WHATSAPP_WEBHOOK_URL=https://api.yourdomain.com/v1/whatsapp/webhook

# ============================================================
# INTEGRATIONS
# ============================================================

# n8n Workflow Automation (self-hosted)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=xxx

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=zerodesk-uploads
R2_PUBLIC_URL=https://cdn.zerodesk.ai

# ============================================================
# BILLING
# ============================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# ============================================================
# DEPLOYMENT (Singapore/India Region)
# ============================================================
RAILWAY_ENVIRONMENT=production
RAILWAY_REGION=asia-southeast1
APP_URL=https://app.zerodesk.ai
API_URL=https://api.zerodesk.ai

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=xxx
LOG_LEVEL=info
