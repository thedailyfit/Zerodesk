generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), uuidOssp(map: "uuid-ossp")]
}

// ============================================================
// TENANT & AUTH
// ============================================================

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  clerkOrgId         String   @unique @map("clerk_org_id")
  name               String
  slug               String   @unique
  industry           String
  logoUrl            String?  @map("logo_url")
  timezone           String   @default("Asia/Kolkata")
  settings           Json     @default("{}")
  subscriptionTier   String   @default("trial") @map("subscription_tier")
  subscriptionStatus String   @default("active") @map("subscription_status")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  assignedLlmId      String?  @map("assigned_llm_id") @db.Uuid
  assignedLlm        GlobalLlmRegistry? @relation("TenantAssignedLlm", fields: [assignedLlmId], references: [id])
  assignedFallbackLlmId String?  @map("assigned_fallback_llm_id") @db.Uuid
  assignedFallbackLlm   GlobalLlmRegistry? @relation("TenantAssignedFallbackLlm", fields: [assignedFallbackLlmId], references: [id])
  allowedVoices      GlobalVoiceRegistry[] @relation("TenantAllowedVoices")

  users              User[]
  customers          Customer[]
  conversations      Conversation[]
  messages           Message[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  pipelineStages     PipelineStage[]
  leads              Lead[]
  activities         Activity[]
  tasks              Task[]
  services           Service[]
  staffMembers       StaffMember[]
  appointments       Appointment[]
  voiceConfig        VoiceConfig?
  whatsappConfig     WhatsappConfig?
  analyticsEvents    AnalyticsEvent[]
  dailyRollups       DailyRollup[]
  subscription       Subscription?
  auditLogs          AuditLog[]

  @@map("tenants")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  email       String
  name        String
  avatarUrl   String?  @map("avatar_url")
  role        String   @default("STAFF")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activities  Activity[]
  ownedLeads  Lead[]     @relation("LeadOwner")
  assignedTasks Task[]   @relation("TaskAssignee")

  @@map("users")
}

// ============================================================
// CUSTOMER MEMORY
// ============================================================

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  phone         String?
  email         String?
  name          String?
  language      String   @default("en")
  leadScore     Int      @default(0) @map("lead_score")
  sentiment     String?
  lifetimeValue Decimal  @default(0) @map("lifetime_value") @db.Decimal(12, 2)
  tags          String[] @default([])
  aiSummary     String?  @map("ai_summary")
  metadata      Json     @default("{}")
  firstSeenAt   DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  appointments  Appointment[]
  leads         Lead[]
  activities    Activity[]     @relation("CustomerActivities")

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("customers")
}

model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  channel    String
  status     String    @default("ACTIVE")
  aiSummary  String?   @map("ai_summary")
  sentiment  String?
  resolution String?
  metadata   Json      @default("{}")
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  endedAt    DateTime? @map("ended_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String?
  mediaUrl       String?  @map("media_url")
  mediaType      String?  @map("media_type")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ============================================================
// KNOWLEDGE BASE
// ============================================================

model KnowledgeDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  title      String
  category   String
  content    String
  sourceType String   @default("MANUAL") @map("source_type")
  fileKey    String?  @map("file_key")
  isActive   Boolean  @default(true) @map("is_active")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkText  String   @map("chunk_text")
  chunkIndex Int      @map("chunk_index")
  embedding  Unsupported("vector(1536)")?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_chunks")
}

// ============================================================
// CRM
// ============================================================

model PipelineStage {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  order     Int
  color     String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, slug])
  @@map("pipeline_stages")
}

model Lead {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  stageId    String    @map("stage_id") @db.Uuid
  ownerId    String?   @map("owner_id") @db.Uuid
  title      String?
  value      Decimal?  @db.Decimal(12, 2)
  score      Int       @default(0)
  source     String?
  tags       String[]  @default([])
  notes      String?
  wonAt      DateTime? @map("won_at") @db.Timestamptz
  lostAt     DateTime? @map("lost_at") @db.Timestamptz
  lostReason String?   @map("lost_reason")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?     @relation(fields: [customerId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  owner      User?         @relation("LeadOwner", fields: [ownerId], references: [id])
  activities Activity[]
  tasks      Task[]

  @@map("leads")
}

model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  leadId     String?  @map("lead_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  type       String
  content    String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation("CustomerActivities", fields: [customerId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@map("activities")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  assignedTo  String?   @map("assigned_to") @db.Uuid
  title       String
  description String?
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead     Lead?  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assignedTo], references: [id])

  @@map("tasks")
}

// ============================================================
// APPOINTMENTS & SERVICES
// ============================================================

model Service {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  description  String?
  durationMins Int      @default(30) @map("duration_mins")
  price        Decimal? @db.Decimal(10, 2)
  category     String?
  schedulePreset String?  @map("schedule_preset")
  isActive     Boolean  @default(true) @map("is_active")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

model StaffMember {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String
  roleTitle      String?  @map("role_title")
  specialization String?
  availability   Json     @default("{}") @db.JsonB
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("staff_members")
}

model Appointment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  serviceId    String?   @map("service_id") @db.Uuid
  staffId      String?   @map("staff_id") @db.Uuid
  status       String    @default("SCHEDULED")
  scheduledAt  DateTime  @map("scheduled_at") @db.Timestamptz
  durationMins Int       @default(30) @map("duration_mins")
  notes        String?
  source       String?
  reminderSent Boolean   @default(false) @map("reminder_sent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id])
  service  Service?     @relation(fields: [serviceId], references: [id])
  staff    StaffMember? @relation(fields: [staffId], references: [id])

  @@map("appointments")
}

// ============================================================
// VOICE & WHATSAPP CONFIG
// ============================================================

model VoiceConfig {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  vapiAssistantId  String?  @map("vapi_assistant_id")
  vapiPhoneNumber  String?  @map("vapi_phone_number")
  voicePersonality String   @default("professional") @map("voice_personality")
  greeting         String?
  languages        String[] @default(["en"])
  transferNumber   String?  @map("transfer_number")
  isActive         Boolean  @default(true) @map("is_active")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("voice_configs")
}

model WhatsappConfig {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @unique @map("tenant_id") @db.Uuid
  wabaId        String?  @map("waba_id")
  phoneNumberId String?  @map("phone_number_id")
  displayPhone  String?  @map("display_phone")
  accessToken   String?  @map("access_token")
  verifyToken   String?  @map("verify_token")
  greeting      String?
  isActive      Boolean  @default(true) @map("is_active")
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_configs")
}

// ============================================================
// ANALYTICS
// ============================================================

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  eventType  String   @map("event_type")
  channel    String?
  customerId String?  @map("customer_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, createdAt])
  @@map("analytics_events")
}

model DailyRollup {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  date           DateTime @db.Date
  metric         String
  dimension      String?
  dimensionValue String?  @map("dimension_value")
  value          Decimal  @db.Decimal(12, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, metric, dimension, dimensionValue])
  @@map("daily_rollups")
}

// ============================================================
// PLATFORM ADMIN
// ============================================================

model Subscription {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @unique @map("tenant_id") @db.Uuid
  plan                  String
  stripeSubId           String?   @map("stripe_sub_id")
  stripeCustId          String?   @map("stripe_cust_id")
  mrr                   Decimal   @default(0) @db.Decimal(10, 2)
  voiceMinutesLimit     Int       @default(100) @map("voice_minutes_limit")
  voiceMinutesUsed      Int       @default(0) @map("voice_minutes_used")
  whatsappMessagesLimit Int       @default(500) @map("whatsapp_messages_limit")
  whatsappMessagesUsed  Int       @default(0) @map("whatsapp_messages_used")
  llmTokensLimit        Int       @default(1000000) @map("llm_tokens_limit")
  llmTokensUsed         Int       @default(0) @map("llm_tokens_used")
  storageLimitMB        Int       @default(1000) @map("storage_limit_mb")
  storageUsedMB         Decimal   @default(0) @map("storage_used_mb") @db.Decimal(10, 2)
  currentPeriodStart    DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd      DateTime? @map("current_period_end") @db.Timestamptz
  pausedUntil           DateTime? @map("paused_until") @db.Timestamptz
  retentionDiscountActive Boolean @default(false) @map("retention_discount_active")
  churnReason           String?   @map("churn_reason")
  status                String    @default("active")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id") @db.Uuid
  details      Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ============================================================
// GLOBAL REGISTRIES (SUPER ADMIN CONTROL PLANE)
// ============================================================

model GlobalVoiceRegistry {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String   // 'elevenlabs', 'sarvam', 'cartesia', 'openai'
  voiceId     String   @unique @map("voice_id") // Provider's voice ID
  name        String   // Display Name e.g. "Kavya"
  gender      String   // "female" | "male" | "neutral"
  language    String   // "hi-IN", "en-US", "te-IN", etc.
  accent      String?  // "Indian English", "Hindi", etc.
  previewUrl  String?  @map("preview_url")
  sampleText  String?  @map("sample_text")
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  tags        String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  allowedTenants Tenant[] @relation("TenantAllowedVoices")

  @@map("global_voice_registries")
}

model GlobalLlmRegistry {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String   // 'openai', 'anthropic', 'groq', 'sarvam', 'deepseek'
  modelId        String   @unique @map("model_id") // 'gpt-4o', 'claude-3-5-sonnet', 'llama-3.3-70b-versatile'
  name           String   // 'GPT-4o Omnichannel'
  contextWindow  Int      @default(128000) @map("context_window")
  costPer1kInput Decimal  @default(0.0025) @map("cost_per_1k_input") @db.Decimal(10, 5)
  costPer1kOutput Decimal @default(0.0100) @map("cost_per_1k_output") @db.Decimal(10, 5)
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  isFallback     Boolean  @default(false) @map("is_fallback")
  category       String   @default("flagship") // 'flagship', 'fast_voice', 'reasoning', 'economy'
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenantsAssigned Tenant[] @relation("TenantAssignedLlm")
  tenantsAssignedFallback Tenant[] @relation("TenantAssignedFallbackLlm")

  @@map("global_llm_registries")
}
