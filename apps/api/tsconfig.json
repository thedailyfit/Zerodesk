{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@zerodesk/shared": [
        "../../packages/shared/dist/index",
        "../../packages/shared/src/index",
        "../../node_modules/@zerodesk/shared"
      ],
      "@zerodesk/shared/*": [
        "../../packages/shared/dist/*",
        "../../packages/shared/src/*",
        "../../node_modules/@zerodesk/shared/*"
      ]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
