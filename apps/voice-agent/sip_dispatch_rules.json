{
  "$schema": "https://livekit.io/schemas/sip-dispatch-rule.json",
  "name": "zerodesk-inbound-plivo-dispatch",
  "description": "Dynamic SIP Dispatch Rule for ZeroDesk Indian Telephony (Plivo) across All Niches",
  "rules": [
    {
      "name": "inbound-plivo-dispatch",
      "dispatchRuleIndividual": {
        "roomPrefix": "call_"
      },
      "metadata": {
        "provider": "plivo",
        "region": "ap-south-1",
        "language_mode": "multilingual_indic",
        "supported_languages": [
          "en-IN",
          "hi-IN",
          "te-IN",
          "ta-IN",
          "kn-IN"
        ]
      },
      "roomConfig": {
        "agents": [
          {
            "agentName": "zerodesk-receptionist"
          }
        ]
      }
    }
  ]
}