{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroDesk Clinic AI",
  "version": "1.2.0",
  "identifier": "com.zerodesk.clinic.desktop",
  "build": {
    "frontendDist": "http://localhost:3000",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @zerodesk/web dev",
    "beforeBuildCommand": "pnpm --filter @zerodesk/web build"
  },
  "app": {
    "windows": [
      {
        "title": "ZeroDesk - Clinic Management & Voice AI Hub",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
