# ==============================================================================
# ZeroDesk Production Environment Variables
# Copy this file to .env.local and fill in the live keys to activate integrations.
# ==============================================================================

# 1. DATABASE & STORAGE (Supabase / PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# 2. AUTHENTICATION & MULTI-TENANCY (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# 3. VOICE AI AGENTS & TELEPHONY (Vapi.ai / Bland AI + Twilio)
VAPI_API_KEY=your_vapi_private_api_key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# 4. WHATSAPP AI & META ADS CRM (Meta for Developers)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=zerodesk_secure_webhook_token_2026

# 5. CORE AI & LLM ENGINES (OpenAI / Anthropic)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# 6. BILLING & PAYMENTS (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# 7. ASYNC TASK QUEUE & WORKFLOW SCHEDULER (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# 8. APP DEPLOYMENT CONFIG
NEXT_PUBLIC_APP_URL=https://app.zerodesk.in
