# ==============================================================================
# ZERODESK FRONTEND ENVIRONMENT VARIABLES (Next.js 15)
# Backend is handled separately via NestJS 11.
# ==============================================================================

# 1. NEXT.JS PUBLIC URL
NEXT_PUBLIC_APP_URL=https://app.zerodesk.in
NEXT_PUBLIC_API_URL=https://api.zerodesk.in

# 2. CLERK AUTHENTICATION (Multi-tenant)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# 3. POSTHOG / SENTRY MONITORING
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://...
